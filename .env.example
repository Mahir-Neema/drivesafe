# ===========================================================================
# DriveSafe Environment Configuration Template
# Copy this file to .env and fill in your values
# ===========================================================================

# Google Gemini API & Cloud Project
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_MODEL=gemma-4-26b-a4b-it

# Local Edge Inference (Ollama)
DRIVESAFE_OLLAMA_URL=http://127.0.0.1:11434
DRIVESAFE_MODEL=gemma4:e2b
DRIVESAFE_EMBEDDING_MODEL=nomic-embed-text

# MongoDB Configuration (Local or MongoDB Atlas)
# Set to your MongoDB Atlas connection string for cloud vector search:
# DRIVESAFE_MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DRIVESAFE_MONGO_URI=mongodb://127.0.0.1:27017
DRIVESAFE_MONGO_DB=drivesafe

# Video Duration & Size Limits (Defaults: 3600s / 60min, 2000MB)
DRIVESAFE_MAX_VIDEO_SECONDS=3600
DRIVESAFE_MAX_UPLOAD_BYTES=2097152000
